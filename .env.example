# ─── App ────────────────────────────────────────────────
APP_NAME=ZN API
APP_ENV=development
APP_DEBUG=True
HOST=127.0.0.1
PORT=8000

# ─── Database (PostgreSQL + PostGIS) ───────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DB_DSN=postgresql+psycopg2://zn:zn@localhost:5432/zn
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── Tests ─────────────────────────────────────────────
TEST_DB_DSN=postgresql+psycopg2://zn:zn@localhost:5432/zn_test
